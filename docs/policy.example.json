{
  "version": 1,
  "owner_id": 101,
  "client_bot_id": 202,
  "server_bot_id": 303,
  "trusted_committers": [
    "maintainer",
    "example-server[bot]",
    "automation-reviewer",
    "example-renovate[bot]",
    "renovate[bot]",
    "dependabot[bot]"
  ],
  "sensitive_path_approval_exemptions": {
    "users": [
      {
        "id": 602,
        "login": "automation-reviewer"
      }
    ],
    "github_apps": [
      {
        "bot_id": 603,
        "bot_login": "example-renovate[bot]"
      }
    ]
  },
  "merge_controls_enabled": true,
  "repositories": [
    {
      "repository": "example-org/project",
      "capabilities": [
        "approve",
        "merge",
        "securefix",
        "release",
        "settings"
      ],
      "release": "github-release",
      "protect_tags": true
    }
  ],
  "default_sensitive_paths": [
    ".github/workflows/**",
    ".github/actions/**",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/go.mod",
    "**/go.sum",
    "**/package.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/pyproject.toml",
    "**/uv.lock",
    "**/requirements*.txt",
    "**/mise.toml",
    "**/.mise.toml",
    "**/mise.lock",
    "**/.mise.lock",
    "**/Makefile",
    "**/Dockerfile*",
    ".goreleaser.*",
    "scripts/**",
    "**/build.rs",
    ".cargo/**",
    "**/.cargo/**"
  ],
  "deployment": {
    "server": {
      "repository": "example-org/controller",
      "id": 404,
      "default_branch": "trunk"
    },
    "owner_login": "maintainer",
    "repository_owner": {
      "login": "example-org",
      "id": 406
    },
    "client_app_id": 501,
    "server_app_id": 502,
    "client_bot_login": "example-client[bot]",
    "server_bot_login": "example-server[bot]",
    "approval_reviewer": {
      "login": "reviewer",
      "id": 601
    },
    "checks": {
      "status_app_id": 701,
      "policy_app_id": 502
    },
    "integration": {
      "repository": "example-org/sandbox",
      "id": 405,
      "default_branch": "trunk"
    },
    "release_branch": "releases/candidate",
    "runtime_update_branch": "automation/runtime"
  }
}
